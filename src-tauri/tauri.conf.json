{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JustIn Replay",
  "version": "0.1.0",
  "identifier": "com.replayapp.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SlickClip",
        "width": 1200,
        "height": 760,
        "minWidth": 950,
        "minHeight": 650,
        "visible": false
      },
      {
        "label": "splash",
        "title": "SlickClip",
        "url": "splash.html",
        "width": 520,
        "height": 320,
        "center": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true
      },
      {
        "label": "save-overlay",
        "title": "Replay Saved",
        "url": "save-overlay.html",
        "width": 340,
        "height": 86,
        "visible": false,
        "focus": false,
        "focusable": false,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "transparent": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$VIDEO/JustIn Replay/Clips/**",
          "$APPLOCALDATA/Library/Previews/**",
          "$APPLOCALDATA/Library/Thumbnails/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
