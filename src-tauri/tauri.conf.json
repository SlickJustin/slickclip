{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SlickClip",
  "version": "1.0.3",
  "identifier": "com.slickclip.desktop",
  "mainBinaryName": "SlickClip",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "SlickClip",
        "width": 1200,
        "height": 760,
        "minWidth": 950,
        "minHeight": 650,
        "decorations": false,
        "visible": false
      },
      {
        "label": "splash",
        "create": false,
        "title": "SlickClip",
        "url": "splash.html",
        "width": 520,
        "height": 320,
        "center": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true
      },
      {
        "label": "save-overlay",
        "create": false,
        "title": "Replay Saved",
        "url": "save-overlay.html",
        "width": 340,
        "height": 86,
        "visible": false,
        "focus": false,
        "focusable": false,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "transparent": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$VIDEO/SlickClip/Clips/**",
          "$APPLOCALDATA/Library/Previews/**",
          "$APPLOCALDATA/Library/Thumbnails/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "SlickClip",
    "shortDescription": "Capture, save, replay, and edit your best moments.",
    "longDescription": "SlickClip is a standalone Windows game capture and replay application with a local clip library and nondestructive editor.",
    "externalBin": [
      "binaries/ffmpeg",
      "binaries/ffprobe"
    ],
    "resources": [
      "binaries/FFmpeg-LICENSE.txt",
      "binaries/FFmpeg-SOURCE.txt"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "headerImage": "icons/installer/header.bmp",
        "sidebarImage": "icons/installer/sidebar.bmp"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": []
    }
  }
}
